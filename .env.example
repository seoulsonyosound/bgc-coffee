# =============================================================================
# BGC COFFEE - Environment Configuration (Non-Secret)
# =============================================================================
# During local development, BGC_DATA_SOURCE defaults to "mock".
# On Amazon EC2, set BGC_DATA_SOURCE=dynamodb.
# Never place AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in committed files.
# On Amazon EC2, attach the IAM Instance Role (bgc-coffee-ec2-role).

BGC_DATA_SOURCE=mock

# AWS Configuration (Phase 2)
AWS_REGION=ap-southeast-2
DYNAMODB_PRODUCTS_TABLE=bgc-coffee-products
DYNAMODB_ORDERS_TABLE=bgc-coffee-orders
DYNAMODB_CUSTOMERS_TABLE=bgc-coffee-customers
S3_ASSETS_BUCKET=
NEXT_PUBLIC_S3_ASSETS_URL=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Admin Portal Credentials (set real values in .env.local on EC2 — never commit)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
